# Inference (Nebius Token Factory)
NEBIUS_API_KEY=changeme

# MLflow (compose service)
MLFLOW_TRACKING_URI=http://mlflow:5000

# Object storage (MinIO; S3-compatible)
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
ARTIFACT_BUCKET=mlops-artifacts

# Airflow (docker compose)
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.2
# Absolute path of this repo on the VM host (bind-mounted identically into containers
# so SWE-bench's docker-out-of-docker sibling containers resolve paths correctly).
HOST_PROJECT=/opt/project
# Image used by the DockerOperator tasks (build with: docker build -t evaluate-agent:latest .)
EVALUATE_AGENT_IMAGE=evaluate-agent:latest
